rules_version = '2';

// Public reads (creator profiles, goals) go through the Admin SDK in
// server/api/profile/*, which bypasses these rules. Nothing on the client
// needs to read another user's document, so nothing is allowed to.
//
// Deploy: Firebase Console -> Firestore Database -> Rules -> paste -> Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Money and analytics move only via the Admin SDK on verified webhooks.
    function moneyFields() {
      return ['currentBalance', 'totalEarnings', 'supporterCount', 'views', 'analytics'];
    }

    // Set once at signup, then frozen: the username is the public link and
    // the seed for the page's cloth.
    function immutableFields() {
      return moneyFields().concat(['uid', 'username']);
    }

    match /users/{userId} {
      // Only the owner reads their own document. This previously allowed
      // anyone to enumerate every creator and their currentBalance.
      allow read: if isOwner(userId);

      // A creator edits their own profile, but money and identity fields are
      // server-only: they move via the Admin SDK on verified Bachs webhooks.
      // diff() is used so the rule holds even before a field exists.
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(moneyFields());

      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(immutableFields());

      allow delete: if false;

      match /bank_accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Written only by the server after a verified Bachs webhook.
    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.toUserId == request.auth.uid;
      allow write: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Webhook deduplication records. Server-only.
    match /webhook_events/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
