rules_version = '2';

// Public profile reads go through the Admin SDK in server/api/profile/*,
// which bypasses these rules. Deploy: Console -> Firestore -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Server-only: moved by the Admin SDK on verified webhooks.
    function moneyFields() {
      return ['currentBalance', 'totalEarnings', 'supporterCount', 'views', 'analytics'];
    }

    // Set at signup, then frozen.
    function immutableFields() {
      return moneyFields().concat(['uid', 'username']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(moneyFields());

      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(immutableFields());

      allow delete: if false;

      match /bank_accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.toUserId == request.auth.uid;
      allow write: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /webhook_events/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
