# ---------------------------------------------------------------------------
# Firebase (client)
#
# These are read through Nuxt runtime config in nuxt.config.ts, so the plain
# FIREBASE_* names below are correct. Do not add a VITE_ prefix.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Firebase Admin (server)
#
# The full service account JSON on one line.
# Firebase Console -> Project Settings -> Service Accounts -> Generate key
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ---------------------------------------------------------------------------
# Bachs (https://bachs.io)
#
# The key prefix selects the environment automatically:
#   sk_sandbox_...  ->  https://sandbox-api.bachs.io/v1
#   sk_live_...     ->  https://api.bachs.io/v1
# Going live is a key swap; no code change.
# ---------------------------------------------------------------------------
BACHS_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxx

# Signing secret for the webhook endpoint, from Developer Portal -> Webhooks.
# Every delivery is verified as HMAC-SHA256 over "{timestamp}.{rawBody}".
BACHS_WEBHOOK_SECRET=

# Which figure is credited to a creator when a tip lands.
#   gross (default) - the full amount paid; TipCup absorbs the processing fee.
#   net             - the settlement amount; the creator bears the fee.
# On `gross`, creator balances grow faster than the Bachs balance backing them.
# BACHS_CREDIT_BASIS=gross

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NUXT_PUBLIC_SITE_URL=https://tipcup.adedeji.xyz
